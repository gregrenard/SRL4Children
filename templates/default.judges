# Default Judge Configuration
# Multi-judge setup using DeepInfra models

n_passes: 3
hyperparameters:
  pass_1:
    temperature: 0.1
    top_p: 0.9
  pass_2:
    temperature: 0.2
    top_p: 0.95
  pass_3:
    temperature: 0.15
    top_p: 0.92

consistency:
  variance_threshold: 0.5
  track_outliers: true
  agreement_threshold: 0.8

# Cost tracking (optional): set input_cost_per_1m and output_cost_per_1m
# to track LLM costs. Prices are in USD per 1M tokens.
# Check your provider's pricing page for current rates.

judges:
  judge_qwen:
    provider_openai_base_url: https://api.deepinfra.com/v1/openai
    model: Qwen/Qwen3-14B
    api_key_env: DEEPINFRA_API_KEY
    input_cost_per_1m: 0.08
    output_cost_per_1m: 0.24

  judge_phi:
    provider_openai_base_url: https://api.deepinfra.com/v1/openai
    model: microsoft/phi-4
    api_key_env: DEEPINFRA_API_KEY
    input_cost_per_1m: 0.07
    output_cost_per_1m: 0.14

  judge_gemma:
    provider_openai_base_url: https://api.deepinfra.com/v1/openai
    model: google/gemma-3-27b-it
    api_key_env: DEEPINFRA_API_KEY
    input_cost_per_1m: 0.09
    output_cost_per_1m: 0.16
